{
  "name": "functions",
  "projectType": "application",
  "root": "functions",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc && tsc-alias",
        "cwd": "functions"
      },
      "dependsOn": ["^build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test src/",
        "cwd": "functions"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "functions"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "firebase deploy --only functions"
      },
      "dependsOn": ["build"]
    }
  }
}
