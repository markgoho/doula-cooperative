{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": ["es2023"],
    "module": "NodeNext",
    "outDir": "lib",
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "es2022",
    "baseUrl": ".",
    "paths": {
      "@doula-coop/shared": ["../shared/src/index.ts"]
    }
  },
  "compileOnSave": true,
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/test-utils/**", "node_modules"]
}
