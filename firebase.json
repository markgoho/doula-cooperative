{
  "firestore": {
    "database": "(default)",
    "location": "us-east4",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": [
    {
      "target": "main-site",
      "public": "hugo/public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/api/forms{,/**}",
          "function": "formsApi"
        },
        {
          "source": "/api/stripe{,/**}",
          "function": "stripeWebhookApi"
        },
        {
          "source": "/api/profile-webhook{,/**}",
          "function": "profileWebhookApi"
        },
        {
          "source": "/api/stripe-webhook",
          "function": "stripeWebhook"
        },
        {
          "source": "/api/profile-deployment-webhook",
          "function": "profileDeploymentWebhook"
        }
      ],
      "headers": [
        {
          "source": "/join-the-doula-cooperative/**",
          "headers": [
            {
              "key": "Permissions-Policy",
              "value": "payment=(self \"https://js.stripe.com\")"
            }
          ]
        },
        {
          "source": "**/*.@(eot|otf|ttf|ttc|woff|woff2|font)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000, immutable"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        },
        {
          "source": "**/*.@(jpg|jpeg|gif|png|ico|webp|svg|avif)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        },
        {
          "source": "**/*.ico",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000, immutable"
            },
            {
              "key": "Content-Type",
              "value": "image/x-icon"
            }
          ]
        },
        {
          "source": "**/*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000, immutable"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Content-Type",
              "value": "text/javascript; charset=utf-8"
            }
          ]
        },
        {
          "source": "**/*.css",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000, immutable"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        },
        {
          "source": "**/manifest.webmanifest",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=604800"
            },
            {
              "key": "Content-Type",
              "value": "application/manifest+json; charset=utf-8"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        }
      ],
