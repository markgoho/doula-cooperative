{
  "name": "hugo",
  "projectType": "application",
  "root": "hugo",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "hugo --minify",
        "cwd": "hugo"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "hugo server --disableFastRender -D",
        "cwd": "hugo"
      }
    }
  }
}
