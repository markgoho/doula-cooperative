{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "dom"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowJs": true,

    // Bundler mode
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["*.ts", "hugo/assets/ts/**/*.ts"],
  "exclude": [
    "node_modules",
    "members",
    "functions/node_modules",
    "hugo/public",
    "hugo/resources",
    "members/dist",
    "firebase-debug.log",
    "firestore-debug.log"
  ]
}
