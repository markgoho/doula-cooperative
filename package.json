{
  "name": "doula-cooperative",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "hugo:dev": "cd hugo && hugo server --disableFastRender",
    "build:local": "rm -rf hugo/public && cd hugo && hugo && bun run index",
    "build": "cd hugo && hugo --minify && bun run index",
    "index": "bunx pagefind --site hugo/public",
    "build:search": "bun run build && bun run index",
    "emulators": "firebase emulators:start --only functions,firestore,auth --import=emulator-seed-data"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.35",
    "@types/bun": "^1.2.21",
    "eslint": "^9.34.0",
    "eslint-plugin-unicorn": "^60.0.0",
    "firebase-tools": "^14.15.1",
    "prettier": "^3.6.2",
    "prettier-plugin-go-template": "^0.0.15",
    "prettier-plugin-organize-imports": "^4.2.0",
    "sharp": "^0.34.3",
    "typescript-eslint": "^8.41.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  }
}
